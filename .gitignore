# macOS
.DS_Store
._*

# Editors
.idea/
.vscode/
*.swp
*~

# Go workspace files. engine and ui are independently versioned modules, each
# with its own go.mod pin on the other, so CI and releases must build against
# those pins rather than a workspace shortcut. A go.work unioning ./engine and
# ./ui is a personal convenience for developing across both locally; create
# your own, same as mimic-templates' own convention for this file
go.work
go.work.sum

# Go build output. The rendercard and mimic binaries are extensionless on Unix,
# so they are named directly rather than caught by a pattern. A plain go build in
# ui/ names its output after the directory, so ignore that too
/dist/
rendercard
rendercard.exe
mimic
/ui/ui
# Packaging output and the temporary files its tasks write
/ui/bin/
/ui/build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
*.syso
*.exe
*.dll
*.so
*.dylib

# Test, coverage and profiling output
*.test
coverage.out
coverage.html
*.prof
*.pprof

# Rendered cards. rendercard defaults to -o card.png in the working directory,
# and /out/ is the convention for anything else rendered by hand
card.png
/out/

# Source frame PSDs and anything extracted from them. These are large binaries
# and are not ours to redistribute, so the extraction step reads them from a
# local path instead of from the repo
*.psd
*.psb
/assets/
# ui/testassets/proxyshop/normal.psd is a tiny synthetic document the Proxyshop
# import tests build by hand, not real frame art, so it is tracked
!/ui/testassets/proxyshop/normal.psd

# User-supplied font overrides. The dropped files are ignored while the
# directory's README stays tracked
/local-fonts/*
!/local-fonts/README.md

# Claude Code per-user settings. Shared .claude/settings.json stays tracked
.claude/settings.local.json
